    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SmoothMin",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float h = max(k - abs(a - b), 0.0) / k;\nOut = min(a, b) - h * h * h * k * (1.0 / 6.0);"
}

